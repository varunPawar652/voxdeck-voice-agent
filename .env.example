# Standard OpenAI API key. Server-side only — never exposed to the browser.
OPENAI_API_KEY=

# Realtime speech-to-speech model and voice.
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Model used for live user-speech transcription shown in the transcript panel.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Backend port and the single browser origin allowed by CORS.
PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Lifetime of the ephemeral client secret handed to the browser (10–7200 seconds).
CLIENT_SECRET_TTL_SECONDS=120
